          "width": 1440,
          "padding": [
            96,
            80,
            72,
            80
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "hero_text_col",
              "name": "Hero Text Column",
              "width": 640,
              "layout": "vertical",
              "gap": 28,
              "children": [
                {
                  "type": "frame",
                  "id": "cloud_tag_pill",
                  "name": "Cloud Badge Tag",
                  "fill": "#1E293B",
                  "cornerRadius": 20,
                  "stroke": "$border-amber",
                  "strokeWidth": 1,
                  "gap": 8,
                  "padding": [
                    6,
                    16
                  ],
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "zap_ic",
                      "name": "Zap Icon",
                      "width": 14,
                      "height": 14,
