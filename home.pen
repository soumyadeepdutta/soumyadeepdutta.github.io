                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "term_line3",
                      "name": "Terminal Line 3",
                      "fill": "$cyan-accent",
                      "content": "📜 Certification: AWS Certified Solutions Architect",
                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "500"
