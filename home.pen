                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "term_line2",
                      "name": "Terminal Line 2",
                      "fill": "$emerald-accent",
