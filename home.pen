                      "fontFamily": "$font-mono",
                      "fontSize": 12,
                      "fontWeight": "700",
                      "letterSpacing": 0.8
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "hero_headline",
                  "name": "Hero Headline",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": 640,
                  "content": "Architecting resilient, sub-15ms backend systems on AWS",
                  "lineHeight": 1.15,
                  "fontFamily": "$font-display",
                  "fontSize": 48,
                  "fontWeight": "800"
                },
                {
                  "type": "text",
                  "id": "hero_subtext",
                  "name": "Hero Description",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 600,
                  "content": "I specialize in building resilient backend microservices, event-driven pipelines, and automated AWS infrastructure to deliver fast, secure, and cost-effective cloud applications.",
