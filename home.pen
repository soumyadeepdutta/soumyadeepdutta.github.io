{
  "version": "2.17",
  "children": [
    {
      "type": "frame",
      "id": "frame_portfolio_dark",
      "x": 0,
      "y": 0,
      "name": "Backend & AWS Portfolio — Desktop (Dark)",
      "theme": {
        "mode": "dark"
      },
      "clip": true,
      "width": 1440,
      "height": 2680,
      "fill": "$bg",
      "layout": "vertical",
      "alignItems": "center",
      "children": [
        {
          "type": "frame",
          "id": "header_nav",
          "name": "Header Navigation",
          "width": 1440,
