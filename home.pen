                      "fill": "$aws-amber"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "name_title_box",
                  "name": "Name & Role Box",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "brand_name",
                      "name": "Brand Name",
                      "fill": "$text-primary",
                      "content": "Soumyadeep Dutta",
                      "fontFamily": "$font-display",
                      "fontSize": 17,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "brand_role",
                      "name": "Role Subtitle",
                      "fill": "$aws-amber",
                      "content": "Senior Backend & AWS Solutions Architect",
                      "fontFamily": "$font-mono",
                      "fontSize": 11,
                      "fontWeight": "600"
