                  "id": "aws_badge_icon",
                  "name": "AWS Logo Badge",
                  "width": 40,
                  "height": 40,
                  "fill": "$card-surface",
                  "cornerRadius": 10,
                  "stroke": "$border-amber",
                  "strokeWidth": 1,
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "cloud_icon_head",
