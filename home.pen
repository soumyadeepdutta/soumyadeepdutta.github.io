          "padding": [
            0,
            80
          ],
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "logo_container",
              "name": "Logo & Status",
              "gap": 16,
              "alignItems": "center",
