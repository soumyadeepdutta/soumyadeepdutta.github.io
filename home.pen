                      "children": [
                        {
                          "type": "text",
                          "id": "snippet_c1",
                          "name": "Snippet Line 1",
                          "fill": "#60A5FA",
                          "content": "// AWS Lambda Event Handler (Golang)",
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "snippet_c2",
                          "name": "Snippet Line 2",
                          "fill": "$text-primary",
                          "content": "func HandleOrderEvent(ctx context.Context, event events.SQSEvent) error {",
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "snippet_c3",
                          "name": "Snippet Line 3",
                          "fill": "$aws-amber",
                          "content": "    return pipeline.ProcessBatch(ctx, event.Records) // sub-10ms P99",
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "snippet_c4",
                          "name": "Snippet Line 4",
                          "fill": "#60A5FA",
                          "content": "}",
                          "fontFamily": "$font-mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "snippet_c5",
                          "name": "Snippet Line 5",
                          "fill": "$text-secondary",
                          "content": "// Zero cold-starts & automated dead-letter retries",
                          "fontFamily": "$font-mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
